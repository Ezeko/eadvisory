# ============================================================================
# E'lique Advisory - cPanel Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your cPanel phpMyAdmin & SMTP credentials
# ============================================================================

# 1. phpMyAdmin / cPanel MySQL Database Details
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_elique_db
DB_USERNAME=cpaneluser_elique_user
DB_PASSWORD=your_cpanel_db_password_here
DB_CHARSET=utf8mb4

# 2. cPanel SMTP & Email Delivery Details
MAIL_MAILER=smtp
SMTP_HOST=mail.eliqueadvisory.com
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USERNAME=hello@eliqueadvisory.com
SMTP_PASSWORD=your_cpanel_email_password_here

# Recipient & Sender Identity
MAIL_TO_ADDRESS=hello@eliqueadvisory.com
MAIL_FROM_ADDRESS=hello@eliqueadvisory.com
MAIL_FROM_NAME="E'lique Advisory"
MAIL_SEND_AUTO_REPLY=true

